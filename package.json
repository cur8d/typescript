    "@vercel/blob": "2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "1.1.1",
    "framer-motion": "13.2.0",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
